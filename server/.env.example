# PostgreSQL connection string.
# Local example:      postgresql://postgres:postgres@localhost:5432/finq?schema=public
# Neon example:       postgresql://USER:PASSWORD@HOST.neon.tech/finq?sslmode=require
DATABASE_URL=

# Comma separated list of allowed browser origins for CORS.
# Local dev + deployed frontend, e.g.
# FRONTEND_URL=http://localhost:5173,https://finq-client.vercel.app
FRONTEND_URL=http://localhost:5173

# Port the HTTP server listens on. Render injects this automatically.
PORT=3000
